{
  "name": "screenpilot-landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:executor": "node extension/tests/executor-engine.test.mjs",
    "test:session": "node extension/tests/session-store.test.mjs",
    "test:nav-classifier": "node extension/tests/navigation-classifier.test.mjs",
    "test:transitions": "node extension/tests/transitions.test.mjs",
    "build:ext": "esbuild extension/v2-task.js --bundle --format=iife --outfile=extension/dist/v2-task.bundle.js && esbuild extension/playground/playground.js --bundle --format=iife --outfile=extension/dist/playground.bundle.js",
    "build:ext:watch": "esbuild extension/v2-task.js --bundle --format=iife --outfile=extension/dist/v2-task.bundle.js --watch & esbuild extension/playground/playground.js --bundle --format=iife --outfile=extension/dist/playground.bundle.js --watch"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "framer-motion": "^12.40.0",
    "lucide-react": "^0.469.0",
    "next": "^15.5.19",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.19",
    "playwright": "^1.61.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0"
  }
}
