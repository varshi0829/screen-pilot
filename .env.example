# ScreenPilot Backend — copy to .env.local for local dev
#
# Provider keys are SERVER-SIDE ONLY (Phase 2: the extension no longer
# accepts or sends a BYOK key). See src/server/model-router.ts for exactly
# how these are used to select a provider/model for each role.

# OpenRouter — primary planner provider when set. Get a free key at:
# https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Gemini — used by /api/analyze (vision role) always, and by /api/plan
# (planner role) only when OPENROUTER_API_KEY is not set. Get a free key at:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional overrides — every one of these has a working default; only set ──
# ── the ones you actually want to change.                                  ──

# Override the model name used for a given role (defaults live in
# src/server/model-router.ts: DEFAULT_OPENROUTER_MODEL / DEFAULT_GEMINI_MODEL).
# PLANNER_MODEL_OPENROUTER=google/gemma-4-26b-a4b-it:free
# PLANNER_MODEL_GEMINI=gemini-2.5-flash
# VISION_MODEL_GEMINI=gemini-2.5-flash

# Opt-in secondary planner provider, tried only once the primary provider's
# chain is fully exhausted. Unset by default — no fallback happens unless you
# set this. Value is "openrouter" or "gemini"; the corresponding *_API_KEY
# above must also be set.
# FALLBACK_PROVIDER=gemini
# FALLBACK_MODEL=gemini-2.5-flash

# Rate limits (requests per 60s window). Defaults: 100 per session, 12 shared
# across all sessions (protects the shared provider key from overload).
# RATE_LIMIT_SESSION_PER_MIN=100
# RATE_LIMIT_GLOBAL_PER_MIN=12
